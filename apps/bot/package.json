{
  "name": "@maxwell/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/locales', 'dist/locales', { recursive: true })\"",
    "start": "node dist/main.js",
    "migrate": "tsx --conditions=source --env-file-if-exists=../../.env src/db/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxerjs/core": "3.3.0",
    "@maxwell/core": "workspace:*",
    "@napi-rs/canvas": "1.0.11",
    "intl-messageformat": "12.1.4",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
