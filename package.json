{
  "name": "maxwell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db": "docker compose -f compose.dev.yaml up -d --wait",
    "dev": "pnpm --filter @maxwell/bot dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "assets": "tsx scripts/render-assets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "@resvg/resvg-js": "2.6.2",
    "tsx": "4.23.15"
  }
}
